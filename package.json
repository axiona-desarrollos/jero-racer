{
  "name": "jero-racer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JERO RACER: juego de trafico en autopista infinita. Three.js + Rapier, modelos de trafico procedurales.",
  "author": "Axiona Desarrollos Inteligentes S.A.S.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
