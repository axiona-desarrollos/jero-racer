{
  "name": "jero-racer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JERO RACER: juego de trafico en autopista infinita. Three.js + Rapier, modelos de trafico procedurales.",
  "author": "Axiona Desarrollos Inteligentes S.A.S.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "models": "node scripts/fetch-models.mjs && node scripts/optimizar-modelos.mjs",
    "carros": "node scripts/preparar-carro.mjs",
    "build:web": "node scripts/revisar-voces.mjs && vite build --mode publico",
    "voces": "node scripts/generar-voces.mjs",
    "voces:borrador": "node scripts/generar-voces.mjs --borrador",
    "build:web:voces-prueba": "node scripts/revisar-voces.mjs --permitir-borrador && vite build --mode publico"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@supabase/realtime-js": "^2.117.3",
    "3d-tiles-renderer": "^0.5.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "eslint": "^9.0.0",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.35.5",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.63.2"
  },
  "homepage": "https://jeroracer.axionasoft.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiona-desarrollos/jero-racer.git"
  }
}
