    "test:watch": "vitest",
    "lint": "eslint src tests",
    "models": "node scripts/fetch-models.mjs && node scripts/optimizar-modelos.mjs",
    "build:web": "vite build --mode publico"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "3d-tiles-renderer": "^0.5.2",
