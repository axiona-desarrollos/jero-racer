  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "eslint": "^9.0.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.63.2"
  }
